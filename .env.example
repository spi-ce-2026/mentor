# =============================================================================
# mentorApp - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env com valores reais.
#
# Variáveis EXPO_PUBLIC_* são injetadas no bundle do app (visíveis no cliente).
# Variáveis sem esse prefixo só ficam disponíveis em app.config.js (build).
# =============================================================================

# -----------------------------------------------------------------------------
# URL da API Gateway (opcional)
# Sem esta variável, o app usa o backend de integração no Heroku:
#   https://mentorias-api-gateway-10fcbc088ede.herokuapp.com/api/v1
# Defina só se o professor indicar outro backend, por exemplo um que rode no
# computador e seja acessado pelo emulador Android: http://10.0.2.2:8080/api/v1
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_API_BASE_URL=

# -----------------------------------------------------------------------------
# Google OAuth Client ID
# Firebase Console > Authentication > Sign-in method > Google > Web client ID
# -----------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_CLIENT_ID=248660691174-b3tbs3gl2i04436l27ralke7s8sk8qda.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Firebase Configuration
# Firebase Console > Project Settings > Your apps > mentorApp (Android)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCyBuaqh_MXpI5OG7mKcaD1Bdzoyf1TAqY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=mentorias-uberhub.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=mentorias-uberhub
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=mentorias-uberhub.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=248660691174
EXPO_PUBLIC_FIREBASE_APP_ID=1:248660691174:android:3a1e4fa587b36e27115327

# -----------------------------------------------------------------------------
# Expo Project ID (opcional — necessário para builds EAS)
# expo.dev > seu projeto > Project ID
# -----------------------------------------------------------------------------
EXPO_PUBLIC_PROJECT_ID=seu-expo-project-id
